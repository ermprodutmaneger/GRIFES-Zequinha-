# ---------------------------------------------------------------------------
# Referencia rapida das variaveis de ambiente do projeto.
#
# IMPORTANTE: este repositorio NAO le arquivos .env em runtime.
#   * no Cloudflare Pages (producao/preview) -> Settings > Variables and Secrets
#   * localmente (wrangler pages dev)        -> arquivo .dev.vars
# Este .env.example serve como documentacao/checklist das variaveis.
# ---------------------------------------------------------------------------

# --- SEGREDOS (configurar como "Secret" no painel; nunca no codigo) ---------
# Access Token de TESTE do Mercado Pago. USO EXCLUSIVO DO SERVIDOR.
MP_ACCESS_TOKEN=""

# Opcional: assinatura secreta configurada no webhook do Mercado Pago.
MP_WEBHOOK_SECRET=""

# --- VARIAVEIS PUBLICAS -----------------------------------------------------
# Public Key de TESTE (pode aparecer no navegador — e o esperado).
MP_PUBLIC_KEY=""

# auto | teste | producao
MP_MODO="auto"

# true -> forca o modo simulacao mesmo sem credenciais configuradas
MP_SIMULACAO=""

MP_LOJA_NOME="GRIFES Zequinha"
MP_MAX_ITENS_POR_PEDIDO="10"
MP_FRETE_GRATIS_ACIMA_DE="299.90"
